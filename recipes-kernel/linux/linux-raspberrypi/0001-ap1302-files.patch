From: Chris Storah <chris.storah@gmail.com>
Date: Tue, 26 Nov 2024 13:01:13 +1100
Upstream-Status: Pending
Subject: [PATCH] ap1302 files

---
 arch/arm/boot/dts/overlays/jac01-overlay.dts |   94 +
 arch/arm/boot/dts/overlays/jac01.dtsi        |   37 +
 drivers/media/i2c/Kconfig                    |   11 +
 drivers/media/i2c/Makefile                   |    1 +
 4 files changed, 133 insertions(+)
 create mode 100644 arch/arm/boot/dts/overlays/jac01-overlay.dts
 create mode 100644 arch/arm/boot/dts/overlays/jac01.dtsi
 
diff --git a/arch/arm/boot/dts/overlays/jac01-overlay.dts b/arch/arm/boot/dts/overlays/jac01-overlay.dts
new file mode 100644
index 000000000000..3850ff4b5115
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/jac01-overlay.dts
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Definitions for JAC01 camera module on VC I2C bus
+/dts-v1/;
+/plugin/;
+
+/{
+	compatible = "brcm,bcm2835";
+
+	i2c_frag: fragment@0 {
+		target = <&i2c_csi_dsi>;
+		__overlay__ {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			#include "jac01.dtsi"
+
+			vcm_node: ad5398@c {
+				compatible = "adi,ad5398";
+				reg = <0x0c>;
+				status = "disabled";
+				VANA-supply = <&cam1_reg>;
+			};
+		};
+	};
+
+	csi_frag: fragment@1 {
+		target = <&csi1>;
+		csi: __overlay__ {
+			status = "okay";
+			brcm,media-controller;
+
+			port {
+				csi_ep: endpoint {
+					remote-endpoint = <&cam_endpoint>;
+					data-lanes = <1 2>;
+					clock-noncontinuous;
+				};
+			};
+		};
+	};
+
+	fragment@2 {
+		target = <&i2c0if>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@3 {
+		target = <&i2c0mux>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	reg_frag: fragment@4 {
+		target = <&cam1_reg>;
+		__overlay__ {
+			startup-delay-us = <20000>;
+		};
+	};
+
+	clk_frag: fragment@5 {
+		target = <&cam1_clk>;
+		__overlay__ {
+			status = "okay";
+			clock-frequency = <25000000>;
+		};
+	};
+
+	__overrides__ {
+		rotation = <&cam_node>,"rotation:0";
+		orientation = <&cam_node>,"orientation:0";
+		media-controller = <&csi>,"brcm,media-controller?";
+		cam0 = <&i2c_frag>, "target:0=",<&i2c_csi_dsi0>,
+		       <&csi_frag>, "target:0=",<&csi0>,
+		       <&reg_frag>, "target:0=",<&cam0_reg>,
+		       <&clk_frag>, "target:0=",<&cam0_clk>,
+		       <&cam_node>, "clocks:0=",<&cam0_clk>,
+		       <&cam_node>, "avdd-supply:0=",<&cam0_reg>,
+		       <&vcm_node>, "VANA-supply:0=",<&cam0_reg>;
+		vcm = <&vcm_node>, "status=okay",
+		       <&cam_node>,"lens-focus:0=", <&vcm_node>;
+	};
+};
+
+&cam_node {
+	status = "okay";
+};
+
+&cam_endpoint {
+	remote-endpoint = <&csi_ep>;
+};
diff --git a/arch/arm/boot/dts/overlays/jac01.dtsi b/arch/arm/boot/dts/overlays/jac01.dtsi
new file mode 100644
index 000000000000..90be36021516
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/jac01.dtsi
@@ -0,0 +1,37 @@
+// Fragment that configures an jac01
+#include <dt-bindings/gpio/gpio.h>
+cam_node: jac01@3d {
+	compatible = "onnn,ap1302";
+	reg = <0x3d>;
+	status = "disabled";
+
+	clocks = <&cam1_clk>;
+	clock-names = "xclk";
+	VANA-supply = <&cam1_reg>;	/* 2.8v */
+	VDIG-supply = <&cam_dummy_reg>;	/* 1.8v */
+	VDDL-supply = <&cam_dummy_reg>;	/* 1.2v */
+	reset-gpios = <&gpio 40 GPIO_ACTIVE_LOW>;
+	// power controlled by the regulator not "standby-gpios = <&gpio 44 GPIO_ACTIVE_HIGH>;"
+	rotation = <0>;
+	orientation = <2>;
+
+	//sensors {
+	//	sensor,model = "ar1335";
+	//	sensor,resolution = <1920 1080>;
+	//	sensor,format = <0x300a>; // MEDIA_BUS_FMT_SGRBG10_1X10
+
+	//	sensor@0 {
+	//		reg = <0>;
+	//	};
+	//};
+
+	port {
+		cam_endpoint: endpoint {
+			clock-lanes = <0>;
+			data-lanes = <1 2>;
+			clock-noncontinuous;
+			link-frequencies =
+				/bits/ 64 <456000000>;
+		};
+	};
+};
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index ba7bdf78e268..929a017c0df6 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -41,6 +41,17 @@ config VIDEO_APTINA_PLL
 config VIDEO_CCS_PLL
 	tristate
 
+config VIDEO_AP1302
+	tristate "ON Semiconductor AP1302 external ISP support"
+	depends on VIDEO_V4L2_I2C
+	select VIDEO_V4L2_SUBDEV_API
+	help
+	  This is a Video4Linux2 sensor driver for the ON Semiconductor
+	  AP1302 ISP.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called ar0521.
+
 config VIDEO_AR0521
 	tristate "ON Semiconductor AR0521 sensor support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 40132cf56ad9..07104ec4dbe1 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -63,6 +63,7 @@ obj-$(CONFIG_VIDEO_IMX708) += imx708.o
 obj-$(CONFIG_VIDEO_IR_I2C) += ir-kbd-i2c.o
 obj-$(CONFIG_VIDEO_IRS1125) += irs1125.o
 obj-$(CONFIG_VIDEO_ISL7998X) += isl7998x.o
+obj-$(CONFIG_VIDEO_AP1302) += jac01.o
 obj-$(CONFIG_VIDEO_KS0127) += ks0127.o
 obj-$(CONFIG_VIDEO_LM3560) += lm3560.o
 obj-$(CONFIG_VIDEO_LM3646) += lm3646.o
