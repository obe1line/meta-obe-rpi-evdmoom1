-#define AP1302_AE_BV_OFF			AP1302_REG_16BIT(0x5014)
 #define AP1302_AE_MET				AP1302_REG_16BIT(0x503E)
 #define AP1302_AE_MET_MASK			0x0003
 #define AP1302_AF_CTRL				AP1302_REG_16BIT(0x5058)
