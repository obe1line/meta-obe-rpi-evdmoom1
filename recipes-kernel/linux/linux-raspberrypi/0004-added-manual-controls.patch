 #endif
 #define V4L2_CID_USER_AP1302_BASE		(V4L2_CID_USER_CCS_BASE + 128)
 
-#define V4L2_CID_AP1302_STEREO_ORDER				(V4L2_CID_USER_AP1302_BASE + 0)
+#define V4L2_CID_AP1302_STEREO_ORDER		(V4L2_CID_USER_AP1302_BASE + 0)
+#define V4L2_CID_AP1302_MANUAL_LUMINANCE	(V4L2_CID_USER_AP1302_BASE + 1)
+#define V4L2_CID_AP1302_MANUAL_EXP_TIME		(V4L2_CID_USER_AP1302_BASE + 2)
+#define V4L2_CID_AP1302_MANUAL_ISO			(V4L2_CID_USER_AP1302_BASE + 3)
+#define V4L2_CID_AP1302_AE_LUMINANCE		(V4L2_CID_USER_AP1302_BASE + 4)
 
 struct ap1302_device;
 
@@ -1545,7 +1553,7 @@ static int ap1302_get_wb_mode(struct ap1302_device *ap1302, s32 *mode)
 	return 0;
 }
 
-static int ap1302_set_exposure(struct ap1302_device *ap1302, s32 mode)
+static int ap1302_set_auto_exposure_mode(struct ap1302_device *ap1302, s32 mode)
 {
 	u32 val;
 	int ret;
@@ -1560,7 +1568,7 @@ static int ap1302_set_exposure(struct ap1302_device *ap1302, s32 mode)
 	return ap1302_write(ap1302, AP1302_AE_CTRL, val, NULL);
 }
 
-static int ap1302_get_exposure(struct ap1302_device *ap1302, s32 *mode)
+static int ap1302_get_auto_exposure_mode(struct ap1302_device *ap1302, s32 *mode)
 {
 	u32 val;
 	int ret;
@@ -1601,12 +1609,88 @@ static int ap1302_get_analogue_gain(struct ap1302_device *ap1302, s32 *value)
 	return 0;
 }
 
+// set for manual luminance
+static int ap1302_set_bv(struct ap1302_device *ap1302, s32 val)
+{
+	return ap1302_write(ap1302, AP1302_AE_MANUAL_BV, val, NULL);
+}
+
+// get for manual luminance
+static int ap1302_get_bv(struct ap1302_device *ap1302, s32 *value)
+{
+	u32 val;
+	int
+	ret = ap1302_read(ap1302, AP1302_AE_MANUAL_BV, &val);
+	if (ret)
+		return ret;
+	*value = val;
+	return 0;
+}
+
+// set for auto-exposure luminance
+static int ap1302_set_ae_bv(struct ap1302_device *ap1302, s32 val)
+{
+	return ap1302_write(ap1302, AP1302_AE_BV, val, NULL);
+}
+
+// get for auto-exposure luminance
+static int ap1302_get_ae_bv(struct ap1302_device *ap1302, s32 *value)
+{
+	u32 val;
+	int ret;
+	ret = ap1302_read(ap1302, AP1302_AE_BV, &val);
+	if (ret)
+		return ret;
+
+	*value = val;
+	return 0;
+}
+
+// set for manual ISO
+static int ap1302_set_manual_iso(struct ap1302_device *ap1302, s32 val)
+{
+	return ap1302_write(ap1302, AP1302_AE_MANUAL_ISO, val, NULL);
+}
+
+// get for manual ISO
+static int ap1302_get_manual_iso(struct ap1302_device *ap1302, s32 *value)
+{
+	u32 val;
+	int ret;
+	ret = ap1302_read(ap1302, AP1302_AE_MANUAL_ISO, &val);
+	if (ret)
+		return ret;
+
+	*value = val;
+	return 0;
+}
+
+// set for manual exposure time
+static int ap1302_set_exp_time(struct ap1302_device *ap1302, s32 val)
+{
+	return ap1302_write(ap1302, AP1302_AE_MANUAL_EXP_TIME, val, NULL);
+}
+
+// get for manual exposure time
+static int ap1302_get_exp_time(struct ap1302_device *ap1302, s32 *value)
+{
+	u32 val;
+	int ret;
+	ret = ap1302_read(ap1302, AP1302_AE_MANUAL_EXP_TIME, &val);
+	if (ret)
+		return ret;
+
+	*value = val;
+	return 0;
+}
+
+// set for manual gain
 static int ap1302_set_gain(struct ap1302_device *ap1302, s32 val)
 {
-	// Format is U8.8
 	return ap1302_write(ap1302, AP1302_AE_MANUAL_GAIN, val, NULL);
 }
 
+// get for manual gain
 static int ap1302_get_gain(struct ap1302_device *ap1302, s32 *value)
 {
 	u32 val;
@@ -1987,7 +2071,7 @@ static int ap1302_s_ctrl(struct v4l2_ctrl *ctrl)
 		return ap1302_set_wb_mode(ap1302, ctrl->val);
 
 	case V4L2_CID_EXPOSURE:
-		return ap1302_set_exposure(ap1302, ctrl->val);
+		return ap1302_set_auto_exposure_mode(ap1302, ctrl->val);
 
 	case V4L2_CID_EXPOSURE_METERING:
 		return ap1302_set_exp_met(ap1302, ctrl->val);
@@ -1995,6 +2079,18 @@ static int ap1302_s_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_GAIN:
 		return ap1302_set_gain(ap1302, ctrl->val);
 
+	case V4L2_CID_AP1302_MANUAL_LUMINANCE:
+		return ap1302_set_bv(ap1302, ctrl->val);
+
+	case V4L2_CID_AP1302_AE_LUMINANCE:
+		return ap1302_set_ae_bv(ap1302, ctrl->val);
+
+	case V4L2_CID_AP1302_MANUAL_ISO:
+		return ap1302_set_manual_iso(ap1302, ctrl->val);
+
+	case V4L2_CID_AP1302_MANUAL_EXP_TIME:
+		return ap1302_set_exp_time(ap1302, ctrl->val);
+
 	case V4L2_CID_ANALOGUE_GAIN:
 		// TODO: Implement
 		return ap1302_set_analogue_gain(ap1302, ctrl->val);
@@ -2060,7 +2156,7 @@ static int ap1302_g_ctrl(struct v4l2_ctrl *ctrl)
 		return ap1302_get_wb_mode(ap1302, &ctrl->val);
 
 	case V4L2_CID_EXPOSURE:
-		return ap1302_get_exposure(ap1302, &ctrl->val);
+		return ap1302_get_auto_exposure_mode(ap1302, &ctrl->val);
 
 	case V4L2_CID_EXPOSURE_METERING:
 		return ap1302_get_exp_met(ap1302, &ctrl->val);
@@ -2068,6 +2164,18 @@ static int ap1302_g_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_GAIN:
 		return ap1302_get_gain(ap1302, &ctrl->val);
 
+	case V4L2_CID_AP1302_MANUAL_LUMINANCE:
+		return ap1302_get_bv(ap1302, &ctrl->val);
+
+	case V4L2_CID_AP1302_AE_LUMINANCE:
+		return ap1302_get_ae_bv(ap1302, &ctrl->val);
+
+	case V4L2_CID_AP1302_MANUAL_ISO:
+		return ap1302_get_manual_iso(ap1302, &ctrl->val);
+
+	case V4L2_CID_AP1302_MANUAL_EXP_TIME:
+		return ap1302_get_exp_time(ap1302, &ctrl->val);
+
 	case V4L2_CID_ANALOGUE_GAIN:
 		return ap1302_get_analogue_gain(ap1302, &ctrl->val);
 
@@ -2174,7 +2282,7 @@ static const struct v4l2_ctrl_config ap1302_ctrls[] = {
 	}, {
