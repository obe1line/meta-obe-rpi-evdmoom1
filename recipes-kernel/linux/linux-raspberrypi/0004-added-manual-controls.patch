 #define AP1302_AE_CTRL_FULL_AUTO		(12U << 0)
 #define AP1302_AE_CTRL_MODE_MASK		0x000f
+#define AP1302_AE_MANUAL_BV				AP1302_REG_16BIT(0x5004)
 #define AP1302_AE_MANUAL_GAIN			AP1302_REG_16BIT(0x5006)
+#define AP1302_AE_MANUAL_ISO			AP1302_REG_16BIT(0x5008)
+#define AP1302_AE_MANUAL_EXP_TIME		AP1302_REG_16BIT(0x500C)
